{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-v2",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "workers_dev": false,
  "vars": { "BETTER_AUTH_URL": "https://relay.a6n.ai" },
  "d1_databases": [
    {
      "binding": "SECURITY_DB",
      "database_name": "relay-security",
      "database_id": "local",
      "migrations_dir": "drizzle/security",
    },
    {
      "binding": "CORE_DB",
      "database_name": "relay-core",
      "database_id": "local",
      "migrations_dir": "drizzle/core",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "CLIENT", "class_name": "ClientDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClientDO"] }],
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "relay-mail" }],
  "queues": { "producers": [{ "binding": "SEND", "queue": "relay-send" }] },
}
