{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-v2",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "workers_dev": false,
  "vars": {
    "BETTER_AUTH_URL": "https://relay.a6n.ai",
    "OTP_MAILER": "ses",
    "INVITE_MAILER": "ses",
    "SES_EVENT_TOPIC_ARNS": "",
    "SYSTEM_FROM_EMAIL": "no-reply@relay.a6n.ai",
    "SYSTEM_FROM_NAME": "Relay",
    "SYSTEM_SES_REGION": "ap-south-1",
  },
  "d1_databases": [
    {
      "binding": "SECURITY_DB",
      "database_name": "relay-security",
      "database_id": "local-security",
      "migrations_dir": "drizzle/security",
    },
    {
      "binding": "CORE_DB",
      "database_name": "relay-core",
      "database_id": "local-core",
      "migrations_dir": "drizzle/core",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "CLIENT", "class_name": "ClientDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClientDO"] }],
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "relay-mail" }],
  "queues": {
    "producers": [
      { "binding": "SEND", "queue": "relay-send" },
      { "binding": "SES_EVENTS", "queue": "relay-ses-events" },
      { "binding": "INBOUND", "queue": "relay-inbound" },
      { "binding": "WEBHOOKS", "queue": "relay-webhooks" },
    ],
    "consumers": [
      {
        "queue": "relay-send",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 10,
        "dead_letter_queue": "relay-send-dlq",
      },
      {
        "queue": "relay-ses-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "relay-ses-events-dlq",
      },
      // relay-inbound attaches only at Phase 7 cutover, after the old apps/relay Worker's consumer is removed.
      {
        "queue": "relay-inbound",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "relay-inbound-dlq",
      },
      {
        "queue": "relay-webhooks",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "relay-webhooks-dlq",
      },
    ],
  },
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
}
