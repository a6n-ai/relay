{
  "name": "relay-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate:security": "drizzle-kit generate --config drizzle.security.config.ts",
    "db:generate:core": "drizzle-kit generate --config drizzle.core.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply relay-security --local && wrangler d1 migrations apply relay-core --local",
    "check:prod-build": "node scripts/check-prod-build.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.18",
    "@foundry/cloud": "github:a6n-ai/foundry#path:packages/cloud",
    "@foundry/themes": "github:a6n-ai/foundry#path:packages/themes",
    "@foundry/ui": "github:a6n-ai/foundry#path:packages/ui",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "better-auth": "^1.7.18",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "drizzle-orm": "^0.45.4",
    "entities": "^9.0.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.70.0",
    "nanoid": "^5.1.16",
    "postal-mime": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "~4.1.0",
    "wrangler": "^4.166.0"
  }
}
