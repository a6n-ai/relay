{
  "name": "relay-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate:security": "drizzle-kit generate --config drizzle.security.config.ts",
    "db:generate:core": "drizzle-kit generate --config drizzle.core.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply relay-security --local && wrangler d1 migrations apply relay-core --local"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.18",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "~4.1.0",
    "wrangler": "^4.166.0"
  }
}
