[
  {
    "route": "import.$kind.ts",
    "title": "Import lists",
    "method": "POST",
    "path": "/api/v1/import/lists",
    "summary": "Copies up to 500 lists from another system. importRef is your own id for the row, so a repeat call does not duplicate it.",
    "schema": "importLists",
    "fields": [
      { "name": "rows", "type": "array", "required": true, "description": "Up to 500 rows." },
      { "name": "rows[].importRef", "type": "string", "required": true, "description": "Your id for the row, 1 to 64 characters." },
      { "name": "rows[].name", "type": "string", "required": true, "description": "1 to 80 characters." },
      { "name": "rows[].consentSource", "type": "string", "required": true, "description": "One of purchase, express_optin, event_signup or import_other." },
      { "name": "rows[].consentNote", "type": "string", "required": false, "description": "Up to 500 characters." }
    ],
    "body": { "rows": [{ "importRef": "legacy-list-1", "name": "Newsletter", "consentSource": "express_optin" }] },
    "status": 200,
    "response": { "data": { "created": 1, "existing": 0, "ids": { "legacy-list-1": "ctl_Example0001" } } },
    "responseNote": "ids maps each importRef to the Relay id. existing counts refs you already imported.",
    "errors": [
      { "status": 400, "message": "invalid input", "when": "The body is not valid JSON, fails validation or has more than 500 rows." },
      { "status": 409, "message": "import ref taken", "when": "An importRef is already used by another app." }
    ]
  },
  {
    "route": "import.$kind.ts",
    "title": "Import templates",
    "method": "POST",
    "path": "/api/v1/import/templates",
    "summary": "Copies up to 500 templates from another system.",
    "schema": "importTemplates",
    "fields": [
      { "name": "rows", "type": "array", "required": true, "description": "Up to 500 rows." },
      { "name": "rows[].importRef", "type": "string", "required": true, "description": "Your id for the row, 1 to 64 characters." },
      { "name": "rows[].name", "type": "string", "required": true, "description": "1 to 120 characters." },
      { "name": "rows[].event, locale, subject, intro, html, text, enabled", "type": "", "required": false, "description": "The same fields and limits as Create a template." }
    ],
    "body": {
      "rows": [
        {
          "importRef": "legacy-template-1",
          "name": "Order confirmation",
          "event": "order_confirmation",
          "subject": "Your order is confirmed",
          "html": "<p>Thanks for your order.</p>",
          "text": "Thanks for your order."
        }
      ]
    },
    "status": 200,
    "response": { "data": { "created": 1, "existing": 0, "ids": { "legacy-template-1": "tpl_Example0001" } } },
    "errors": [
      { "status": 400, "message": "invalid input", "when": "The body is not valid JSON, fails validation or has more than 500 rows." },
      { "status": 409, "message": "import ref taken", "when": "An importRef is already used by another app." },
      { "status": 409, "message": "template event taken", "when": "Another template of the app already uses the event." }
    ]
  },
  {
    "route": "import.$kind.ts",
    "title": "Import campaigns",
    "method": "POST",
    "path": "/api/v1/import/campaigns",
    "summary": "Copies up to 500 past campaigns, with their counters, into your app. Imported campaigns are draft, sent or cancelled, never sending.",
    "schema": "importCampaigns",
    "fields": [
      { "name": "rows", "type": "array", "required": true, "description": "Up to 500 rows." },
      { "name": "rows[].importRef", "type": "string", "required": true, "description": "Your id for the row, 1 to 64 characters." },
      { "name": "rows[].name", "type": "string", "required": true, "description": "1 to 80 characters." },
      { "name": "rows[].status", "type": "string", "required": true, "description": "draft, sent or cancelled." },
      { "name": "rows[].fromEmail", "type": "string (email) or null", "required": true, "description": "The sender address." },
      { "name": "rows[].subject, html, text", "type": "string", "required": true, "description": "The content. subject has no line breaks." },
      { "name": "rows[].listIds", "type": "array of strings", "required": true, "description": "Up to 50 Relay list ids, for example from Import lists." },
      { "name": "rows[].counters", "type": "object", "required": false, "description": "Any of recipients, queued, sent, failed, suppressed, delivered, opened, clicked, bounced, complained and unsubscribed, as non-negative integers." }
    ],
    "body": {
      "rows": [
        {
          "importRef": "legacy-campaign-1",
          "name": "October news",
          "status": "sent",
          "fromEmail": "news@acme.test",
          "subject": "What is new in October",
          "html": "<p>Hello from Acme.</p>",
          "text": "Hello from Acme.",
          "listIds": ["ctl_Example0001"],
          "counters": { "recipients": 120, "sent": 120, "delivered": 118, "opened": 60 }
        }
      ]
    },
    "status": 200,
    "response": { "data": { "created": 1, "existing": 0, "ids": { "legacy-campaign-1": "cmp_Example0001" } } },
    "errors": [
      { "status": 400, "message": "invalid input", "when": "The body is not valid JSON, fails validation or has more than 500 rows." },
      { "status": 409, "message": "import ref taken", "when": "An importRef is already used by another app." },
      { "status": 409, "message": "unknown list", "when": "A listIds entry is not a list of your app." }
    ]
  },
  {
    "route": "import.$kind.ts",
    "title": "Import messages",
    "method": "POST",
    "path": "/api/v1/import/messages",
    "summary": "Copies up to 500 past messages into your app as history. Nothing is sent.",
    "schema": "importMessages",
    "fields": [
      { "name": "rows", "type": "array", "required": true, "description": "1 to 500 rows." },
      { "name": "rows[].importRef", "type": "string", "required": true, "description": "Your id for the row, 1 to 200 characters." },
      { "name": "rows[].toEmail", "type": "string (email)", "required": true, "description": "The recipient." },
      { "name": "rows[].stream", "type": "string", "required": true, "description": "transactional, tracked or marketing." },
      { "name": "rows[].event", "type": "string or null", "required": true, "description": "Up to 80 characters." },
      { "name": "rows[].subject", "type": "string", "required": true, "description": "Up to 300 characters, with no line breaks." },
      { "name": "rows[].status", "type": "string", "required": true, "description": "sent, failed or suppressed." },
      { "name": "rows[].error", "type": "string or null", "required": true, "description": "Up to 500 characters." },
      { "name": "rows[].createdAt", "type": "integer", "required": true, "description": "Epoch milliseconds." },
      { "name": "rows[].sentAt, deliveredAt, bouncedAt, complainedAt", "type": "integer or null", "required": true, "description": "Epoch milliseconds, or null." },
      { "name": "rows[].sesMessageId", "type": "string or null", "required": true, "description": "Up to 200 characters." },
      { "name": "rows[].opens, clicks", "type": "integer", "required": true, "description": "Counts, zero or more." }
    ],
    "body": {
      "rows": [
        {
          "importRef": "legacy-message-1",
          "toEmail": "ada@example.com",
          "stream": "transactional",
          "event": "order_confirmation",
          "subject": "Your order is confirmed",
          "status": "sent",
          "error": null,
          "createdAt": 1795000000000,
          "sentAt": 1795000002000,
          "sesMessageId": null,
          "opens": 1,
          "clicks": 0,
          "deliveredAt": 1795000003000,
          "bouncedAt": null,
          "complainedAt": null
        }
      ]
    },
    "status": 200,
    "response": { "data": { "created": 1, "existing": 0 } },
    "errors": [
      { "status": 400, "message": "invalid input", "when": "The body is not valid JSON, fails validation or has more than 500 rows." },
      { "status": 409, "message": "import ref taken", "when": "An importRef is already used by another app." }
    ]
  },
  {
    "route": "import.$kind.ts",
    "title": "Import suppressions",
    "method": "POST",
    "path": "/api/v1/import/suppressions",
    "summary": "Adds up to 500 addresses to the suppression list, so Relay never sends to them.",
    "schema": "importSuppressions",
    "fields": [
      { "name": "rows", "type": "array", "required": true, "description": "Up to 500 rows." },
      { "name": "rows[].email", "type": "string (email)", "required": true, "description": "The address to suppress." },
      { "name": "rows[].reason", "type": "string", "required": true, "description": "unsubscribe, bounce, complaint or manual." },
      { "name": "rows[].stream", "type": "string", "required": false, "description": "transactional, tracked or marketing. Omit it for a suppression that is not tied to one stream." }
    ],
    "body": { "rows": [{ "email": "ada@example.com", "reason": "unsubscribe", "stream": "marketing" }] },
    "status": 200,
    "response": { "data": { "created": 1, "existing": 0, "ids": {} } },
    "errors": [{ "status": 400, "message": "invalid input", "when": "The body is not valid JSON, fails validation or has more than 500 rows." }]
  }
]
