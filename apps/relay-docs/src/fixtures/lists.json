  {
    "route": "lists.ts",
    "title": "Create a list",
    "method": "POST",
    "path": "/api/v1/lists",
    "summary": "Creates an empty list and records where its consent came from.",
    "schema": "listCreate",
    "fields": [
      { "name": "name", "type": "string", "required": true, "description": "1 to 80 characters after trimming." },
      { "name": "consentSource", "type": "string", "required": true, "description": "One of purchase, express_optin, event_signup or import_other." },
      { "name": "consentNote", "type": "string", "required": false, "description": "Up to 500 characters." }
    ],
    "body": { "name": "Newsletter", "consentSource": "express_optin", "consentNote": "Signed up on the website" },
    "status": 201,
    "response": {
      "data": {
        "id": "ctl_Example0001",
        "appId": "app_Example0001",
        "name": "Newsletter",
        "consentSource": "express_optin",
        "consentNote": "Signed up on the website",
        "members": 0,
        "createdAt": 1795000000000
      }
    },
    "errors": [{ "status": 400, "message": "invalid input", "when": "The body is not valid JSON or fails validation." }]
  },
  {
    "route": "lists.$id.ts",
    "title": "Get a list",
    "method": "GET",
    "path": "/api/v1/lists/{id}",
