    "pathParams": [{ "name": "id", "example": "ctl_Example0001", "description": "The list id." }],
    "schema": "membersImport",
    "fields": [{ "name": "rows", "type": "array", "required": true, "description": "Up to 1,000 member objects with the same fields as Add a member." }],
    "body": {
      "rows": [
        { "email": "ada@example.com", "firstName": "Ada", "lastName": "Lovelace" },
        { "email": "grace@example.com", "firstName": "Grace", "lastName": "Hopper" }
      ]
    },
    "status": 200,
    "response": { "data": { "added": 2, "existing": 0, "suppressed": 0 } },
    "errors": [
