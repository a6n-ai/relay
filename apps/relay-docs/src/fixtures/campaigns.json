      { "status": 409, "message": "campaign not editable", "when": "The campaign is no longer a draft." },
      { "status": 409, "message": "campaign not ready: <problems>", "when": "The draft is incomplete. problems is a comma-separated list of from_missing, subject_missing, html_missing, text_missing, audience_empty, audience_hook_missing, data_fields_need_hook, unsubscribe_missing and postal_address_missing." },
