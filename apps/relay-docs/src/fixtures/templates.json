  {
    "route": "templates.send.ts",
    "title": "Send a template",
    "method": "POST",
    "path": "/api/v1/templates/send",
    "summary": "Renders a template for one recipient and queues the email.",
    "schema": "sendTemplate",
    "fields": [
      { "name": "templateId", "type": "string", "required": true, "description": "The template to render." },
      { "name": "stream", "type": "string", "required": true, "description": "One of transactional, tracked or marketing. Only marketing may include an unsubscribe link." },
      { "name": "to", "type": "string (email)", "required": true, "description": "The recipient." },
      { "name": "from", "type": "string (email)", "required": false, "description": "A verified sender. Defaults to the app's sender for the stream." },
      { "name": "contact", "type": "object", "required": false, "description": "firstName and lastName, each up to 200 characters, for the merge fields." },
      { "name": "data", "type": "object", "required": false, "description": "Up to 10 keys matching ^[a-z0-9_]{1,40}$. Each value is a string of at most 200 characters." },
      { "name": "event", "type": "string", "required": false, "description": "A label you choose." },
      { "name": "idempotencyKey", "type": "string", "required": false, "description": "A repeat with the same key returns the first message." }
    ],
    "body": {
      "templateId": "tpl_Example0001",
      "stream": "transactional",
      "to": "ada@example.com",
      "contact": { "firstName": "Ada" },
      "data": { "order_number": "1042" },
      "idempotencyKey": "order-1042"
    },
    "status": 201,
    "response": { "data": { "messageId": "msg_Example0001", "status": "queued", "duplicate": false } },
    "errors": [
      { "status": 400, "message": "invalid input", "when": "The body is not valid JSON or fails validation." },
      { "status": 400, "message": "unsubscribe only on marketing", "when": "The template has an unsubscribe link and the stream is not marketing." },
      { "status": 400, "message": "unsubscribe link required", "when": "A marketing message lacks the unsubscribe link in html or text." },
      { "status": 403, "message": "workspace_suspended", "when": "The workspace is suspended." },
      { "status": 404, "message": "template not found", "when": "The template does not exist for your app." },
      { "status": 409, "message": "template disabled", "when": "The template is not enabled." },
      { "status": 422, "message": "no_default_sender", "when": "from is omitted and the app has no default sender for the stream." },
      { "status": 422, "message": "sender_not_verified", "when": "from is not a verified sender." },
      { "status": 429, "message": "quota_exceeded", "when": "The monthly send quota is used up." }
    ]
  }
]
