  {
    "route": "templates.ts",
    "title": "Create a template",
    "method": "POST",
    "path": "/api/v1/templates",
    "summary": "Creates a template. Send it later by id with the template send endpoint.",
    "schema": "templateCreate",
    "fields": [
      { "name": "name", "type": "string", "required": true, "description": "1 to 120 characters." },
      { "name": "event", "type": "string or null", "required": false, "description": "Up to 80 characters. Only one template per app can use an event." },
      { "name": "locale", "type": "string", "required": false, "description": "2 to 35 characters, such as en." },
      { "name": "subject", "type": "string", "required": false, "description": "Up to 300 characters, with no line breaks." },
      { "name": "intro", "type": "string or null", "required": false, "description": "Up to 2000 characters." },
      { "name": "html", "type": "string", "required": false, "description": "Up to 500,000 characters." },
      { "name": "text", "type": "string", "required": false, "description": "Up to 500,000 characters." },
      { "name": "enabled", "type": "boolean", "required": false, "description": "Whether the template can be sent." }
    ],
    "body": {
      "name": "Order confirmation",
      "event": "order_confirmation",
      "locale": "en",
      "subject": "Your order is confirmed",
      "html": "<p>Hi {{contact.first_name}}, thanks for your order.</p>",
      "text": "Hi {{contact.first_name}}, thanks for your order.",
      "enabled": true
    },
    "status": 201,
    "response": {
      "data": {
        "id": "tpl_Example0001",
        "appId": "app_Example0001",
        "name": "Order confirmation",
        "event": "order_confirmation",
        "locale": "en",
        "subject": "Your order is confirmed",
        "intro": null,
        "html": "<p>Hi {{contact.first_name}}, thanks for your order.</p>",
        "text": "Hi {{contact.first_name}}, thanks for your order.",
        "enabled": true,
        "createdAt": 1795000000000,
        "updatedAt": 1795000000000
      }
    },
    "errors": [
      { "status": 400, "message": "invalid input", "when": "The body is not valid JSON or fails validation." },
      { "status": 400, "message": "unknown merge field", "when": "subject, intro, html or text uses a merge field Relay does not know." },
      { "status": 409, "message": "template event taken", "when": "Another template of the app already uses this event." }
    ]
  },
