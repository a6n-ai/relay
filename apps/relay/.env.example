DATABASE_URL=postgres://relay:relay@127.0.0.1:5432/relay
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3010
# Auth browser client is same-origin (/api/auth). Do not set NEXT_PUBLIC_BETTER_AUTH_URL.
# Optional; falls back to BETTER_AUTH_SECRET. Used to HMAC /unsubscribe links.
# RELAY_UNSUBSCRIBE_SECRET=
NOTIFY_FROM_EMAIL=noreply@example.com
NOTIFY_FROM_NAME=Relay

# ses (default) or smtp
EMAIL_TRANSPORT=ses
AWS_REGION=us-east-1
# SES_CONFIGURATION_SET=

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_SPF_INCLUDE=amazonses.com
# SMTP_DKIM_DOMAIN=example.com
# SMTP_DKIM_SELECTOR=relay
# SMTP_DKIM_PRIVATE_KEY=

# Twilio (optional). Without these, SMS outbox rows fail drain with no handler.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+15551234567
# TWILIO_WHATSAPP_FROM=+15551234567
# TWILIO_STATUS_CALLBACK_URL=

# WhatsApp — Meta Cloud API preferred when token + phone_number_id are set.
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_GRAPH_VERSION=v22.0
# Webhook callback: GET/POST /api/webhooks/whatsapp
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# HMAC for POST /api/internal/mailbox/inbound (provider → Relay). Never commit the real secret.
# MAILBOX_INBOUND_SECRET=

# People mail host for Mail.app (not a Relay sending / From domain).
# PEOPLE_MAIL_DOMAIN=mail.example.com

# Worker poll interval when LISTEN/NOTIFY is idle
# NOTIFY_DRAIN_INTERVAL_MS=15000

