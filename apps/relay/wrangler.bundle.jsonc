// Only used by cloudflare/prebundle.mjs: the unminified bundle step. Keep compatibility_date and
// compatibility_flags identical to wrangler.jsonc; bindings are not needed to bundle.
{
  "name": "relay-bundle",
  "main": "cloudflare/worker.js",
  "minify": false,
  "upload_source_maps": false,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"]
}
