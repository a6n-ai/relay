// Relay on Cloudflare Workers (OpenNext). Secrets are never in this file; set them with
// `wrangler secret put <NAME>`: BETTER_AUTH_SECRET, CRON_SECRET, MAILBOX_INBOUND_SECRET,
// RELAY_UNSUBSCRIBE_SECRET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY (IAM user relay-workers),
// and when used TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, WHATSAPP_ACCESS_TOKEN, WHATSAPP_APP_SECRET,
// WHATSAPP_VERIFY_TOKEN. No DATABASE_URL: Hyperdrive. Runbook: deployment/cloudflare/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // OpenNext's worker wrapped with the outbox Queue consumer, RelayWake and the Email Routing handler.
  "main": "cloudflare/worker.js",
  "name": "relay",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets", "run_worker_first": false },
  "observability": { "enabled": true },
  // Run next to Neon (aws-us-east-1) and SES us-east-1: pages make many queries.
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "relay.a6n.ai", "custom_domain": true }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "relay" }],
  // Workflows + the Queue drain the outbox. An omitted "triggers" key would keep any old cron.
  "triggers": { "crons": [] },
  // Deployment id, read by cloudflare/bootstrap.js so the wake chain restarts once per deploy.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Hyperdrive relay-prod -> Neon relay (direct endpoint), created with --caching-disabled true.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "PLACEHOLDER",
      "localConnectionString": "postgres://relay:relay@localhost:5432/relay"
    }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "PLACEHOLDER" }], // relay-cache
  "queues": {
    "producers": [{ "binding": "OUTBOX", "queue": "relay-outbox" }],
    "consumers": [{ "queue": "relay-outbox", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "relay-outbox-dlq" }]
  },
  "workflows": [{ "name": "relay-wake", "binding": "RELAY_WAKE", "class_name": "RelayWake" }],
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    "AWS_REGION": "us-east-1",
    "EMAIL_TRANSPORT": "ses",
    "SES_CONFIGURATION_SET": "relay-prod",
    "NOTIFY_FROM_EMAIL": "no-reply@relay.a6n.ai",
    "NOTIFY_FROM_NAME": "Relay",
    "BETTER_AUTH_URL": "https://relay.a6n.ai"
  }
}
