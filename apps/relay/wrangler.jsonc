{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "src/server.ts",
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // The Vite plugin supplies the directory (dist/client); the binding lets the Worker serve the docs 404 page.
  "assets": { "binding": "ASSETS" },
  "workers_dev": false,
  "routes": [{ "pattern": "relay.a6n.ai", "custom_domain": true }],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "BETTER_AUTH_URL": "https://relay.a6n.ai",
    "OTP_MAILER": "ses",
    "INVITE_MAILER": "ses",
    "SES_EVENT_TOPIC_ARNS": "arn:aws:sns:ap-south-1:947042607945:relay-ses-events,arn:aws:sns:us-east-1:947042607945:relay-ses-events",
    "SYSTEM_FROM_EMAIL": "no-reply@relay.a6n.ai",
    "SYSTEM_FROM_NAME": "Relay",
    "SYSTEM_SES_REGION": "ap-south-1",
  },
  "d1_databases": [
    {
      "binding": "SECURITY_DB",
      "database_name": "relay-security",
      "database_id": "9195732e-2204-4250-a50d-1514aa69f941",
      "migrations_dir": "drizzle/security",
    },
    {
      "binding": "CORE_DB",
      "database_name": "relay-core",
      "database_id": "5d2fdb97-5fcb-4e88-a4c8-312199a32ada",
      "migrations_dir": "drizzle/core",
    },
  ],
  "workflows": [
    { "name": "relay-campaign", "binding": "CAMPAIGNS", "class_name": "CampaignWorkflow" },
    // Operator jobs (seed, sweep): `wrangler workflows trigger relay-ops '{"op":"sweep"}'`.
    { "name": "relay-ops", "binding": "OPS", "class_name": "OpsWorkflow" },
  ],
  "durable_objects": {
    "bindings": [{ "name": "CLIENT", "class_name": "ClientDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClientDO"] }],
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "relay-mail" }],
  "queues": {
    "producers": [
      { "binding": "SEND", "queue": "relay-send" },
      { "binding": "SES_EVENTS", "queue": "relay-ses-events" },
      { "binding": "INBOUND", "queue": "relay-inbound-mail" },
      { "binding": "WEBHOOKS", "queue": "relay-webhooks" },
    ],
    "consumers": [
      {
        "queue": "relay-send",
        "max_batch_size": 10,
        // 0: one email starts the consumer at once; campaign messages still arrive together and batch.
        "max_batch_timeout": 0,
        "max_retries": 10,
        "dead_letter_queue": "relay-send-dlq",
      },
      {
        "queue": "relay-ses-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "relay-ses-events-dlq",
      },
      {
        "queue": "relay-inbound-mail",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "relay-inbound-mail-dlq",
      },
      {
        "queue": "relay-webhooks",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "relay-webhooks-dlq",
      },
    ],
  },
  // TiffinGrab's audience entrypoint. Only a platform admin can point an app's audience hook at it.
  "services": [{ "binding": "TIFFIN_AUDIENCE", "service": "tiffin-grab", "entrypoint": "RelayAudience" }],
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
}
