# Reference for SSM keys under /relay/prod/<KEY>. deploy.sh generates
# .env.production from Parameter Store on every deploy — do not hand-edit it
# on the box.
#
#   aws ssm put-parameter --region us-east-1 --overwrite \
#     --name /relay/prod/<KEY> --type SecureString --value '<value>'
#   cd ~/relay/deployment/prod/relay && ./deploy.sh

NODE_ENV=production
LOG_LEVEL=info

# App through PgBouncer (compose service name). No sslmode on the pooler URL.
DATABASE_URL=postgres://USER:PASSWORD@pgbouncer:6432/relay
# Migrations + drain worker LISTEN hit RDS directly.
DIRECT_DATABASE_URL=postgres://USER:PASSWORD@your-db.xxxxx.us-east-1.rds.amazonaws.com:5432/relay?sslmode=no-verify

PGBOUNCER_DB_HOST=your-db.xxxxx.us-east-1.rds.amazonaws.com
PGBOUNCER_DB_PORT=5432
PGBOUNCER_DB_USER=USER
PGBOUNCER_DB_PASSWORD=PASSWORD
PGBOUNCER_DB_NAME=relay

BETTER_AUTH_URL=https://relay.example.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://relay.example.com
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32

AWS_REGION=us-east-1
EMAIL_TRANSPORT=ses
NOTIFY_FROM_EMAIL=noreply@example.com
NOTIFY_FROM_NAME=Relay

# Optional
# SES_CONFIGURATION_SET=
# RELAY_UNSUBSCRIBE_SECRET=
# MAILBOX_INBOUND_SECRET=
# PEOPLE_MAIL_DOMAIN=mail.example.com
# NOTIFY_DRAIN_INTERVAL_MS=15000
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
